# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Blender
*.blend1
*.blend2
# The main-study .blend is GENERATED by scripts/build_scene.py from
# configs/scenes/final_scene.yaml (D-022), not hand-modelled. Committing it
# would create a second, editable copy of the scene that could silently drift
# away from the config that is supposed to define it.
data/raw/*.blend

# Generated data (regeneratable from configs + code — see PROJECT_STRUCTURE.md)
# NOTE: the rendered PNG sets are ignored, but data/blender_scenes/cameras.json
# and transforms_*.json are deliberately NOT — they are the durable audit record
# of the camera rig, and after Phase 4 Step 5 cameras.json carries the MEASURED
# |V_target| and per-view mask areas, which cannot be regenerated without
# re-rendering the whole scene. Ignoring the directory wholesale would put a
# reported number outside version control (D-023).
data/blender_scenes/train/
data/blender_scenes/val/
data/blender_scenes/eval_holdout/
data/masks/
data/background_plates/
data/poisoned/

# External datasets (downloaded, not generated — see PROJECT_STRUCTURE.md
# for the Phase 2 sanity-check dataset note)
data/nerf_synthetic/

# Model checkpoints / training artifacts / per-run tensorboard logs
# (results.csv + experiments/logs/*.md are the durable record)
experiments/runs/
*.ckpt
*.pth

# OS/editor cruft
.DS_Store
.vscode/
